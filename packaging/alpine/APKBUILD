pkgname=git-hooks-ext
pkgver=0.4.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
a5d707d1fd9b06e0d5b61884d435a3eafcdfd02bf1a751afa90e16239dcc16dae345daa7f52c2bc11b705d1709b4af00cc079dafb0709e07f936ebc459510a01  git-hooks-ext-0.4.0.tar.gz
"
