pkgname=git-hooks-ext
pkgver=0.4.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
9316d7051349e6ff6bc0840b264e9709cba52ec368e0b32fca40f7176f9ea5eb96ca5a9c9cc1384b0a3755cb1df1b08aaf4548b3dd2d0101d0e5cfdb7531957e  git-hooks-ext-0.4.0.tar.gz
"
