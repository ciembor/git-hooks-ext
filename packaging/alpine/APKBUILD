pkgname=git-hooks-ext
pkgver=0.4.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
4b19c37bf6aa24b811b765aa6cd51649ec2fae895f3f42e61e1883304623fe6719fe7be975d2f19b1171f86999ffd943d62a058c31471b712f1bd2213787c027  git-hooks-ext-0.4.0.tar.gz
"
