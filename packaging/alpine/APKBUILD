pkgname=git-hooks-ext
pkgver=0.4.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
0c27149ddbcb034a7bc0d4ba491a9c48e1e463390a3ecccd85f070be19c2abec78907af4b8021ca80905a93c5e15a1601d9c876054e81b8d76773686af7f2c84  git-hooks-ext-0.4.0.tar.gz
"
