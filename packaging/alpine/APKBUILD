pkgname=git-hooks-ext
pkgver=0.4.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
68e9d5274d5ff0e38a5bd617d218c1b42e7e766aa599d837175bd588d7a06b060b3854ba72d294fb814030fd1bab4c0d1dcca3ea670a680cb5092aadb3edacae  git-hooks-ext-0.4.0.tar.gz
"
