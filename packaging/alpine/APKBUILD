pkgname=git-hooks-ext
pkgver=0.5.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
6d8532addbc9128f51ba3c8d26aa96fc3eeea532f5854543e8b2f3fcd3513a2146f25c0dd38a4807d58ed1620dd93e34212322d9cab32db07fa3c966ee8115f4  git-hooks-ext-0.5.0.tar.gz
"
