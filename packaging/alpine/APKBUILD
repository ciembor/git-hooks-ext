pkgname=git-hooks-ext
pkgver=0.5.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
6d3895c889ae9e3850a7352876ece23bd93f5163b50d81469ed0838d97e560960054ab78fa0477ed0cac686b19b6f810cf9da3e78b97101553c996e452be0d7a  git-hooks-ext-0.5.0.tar.gz
"
