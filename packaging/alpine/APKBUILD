pkgname=git-hooks-ext
pkgver=0.6.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
7d59de13daccd3ec37baeaad6634cb28d5bfd2b83b39f03ac57331adccdd80ee69076b76a82fd2ccf653d2c8ef28eeb5c5dce569b5eb0709c84cefedaf8e41bb  git-hooks-ext-0.6.0.tar.gz
"
