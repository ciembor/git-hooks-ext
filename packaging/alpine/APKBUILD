pkgname=git-hooks-ext
pkgver=0.1.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
c5642a04c20aa27db7cf8bef6ebfc4e21d31df2fd7aca7ce5aedc7214be4cb50e4421aec33139f5d5eb47cac003911146fadc3cca6a822bd7018355fe31d511d  git-hooks-ext-0.1.0.tar.gz
"
