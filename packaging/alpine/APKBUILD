pkgname=git-hooks-ext
pkgver=0.2.0
pkgrel=0
pkgdesc="Semantic Git hooks for reference changes"
url="https://github.com/ciembor/git-hooks-ext"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="git>=2.29"
makedepends="build-base git"
source="$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
builddir="$srcdir"

build() {
  make
}

check() {
  make test
}

package() {
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

sha512sums="
c6cc68b451b0957c673feaf5a62fca52c48c437c520da2cdea8bc308c036d2b62ddd95ea5cce4898644c15fc6b07fb3f7370d5f4cbd2ce2c104da17e141b0bb4  git-hooks-ext-0.2.0.tar.gz
"
