FROM docker.io/library/fedora:44 AS builder
RUN dnf install -y gcc make git rpm-build curl && dnf clean all
WORKDIR /build
COPY packaging/fedora/git-hooks-ext.spec /build/SPECS/git-hooks-ext.spec
RUN mkdir -p SOURCES && curl -fL --retry 3 -o SOURCES/git-hooks-ext-0.1.0.tar.gz https://github.com/ciembor/git-hooks-ext/releases/download/v0.1.0/git-hooks-ext-0.1.0.tar.gz && echo '594c70215f9a660b5d9d0281930e1cf0e6fd93f62d91460a1213d59f11159a5d  SOURCES/git-hooks-ext-0.1.0.tar.gz' | sha256sum -c - && rpmbuild -ba --define '_topdir /build' SPECS/git-hooks-ext.spec
RUN mkdir /packages && find RPMS SRPMS -name '*.rpm' -exec cp {} /packages/ \;

FROM docker.io/library/fedora:44
COPY --from=builder /packages /packages
COPY tests/packages/smoke.sh tests/packages/native-install.sh /checks/
ENV PACKAGE_FAMILY=fedora
ENTRYPOINT ["/bin/sh", "/checks/native-install.sh"]
