Checks: >-
  -*,
  clang-analyzer-core.*,
  clang-analyzer-deadcode.*,
  clang-analyzer-unix.*,
  bugprone-branch-clone,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-macro-parentheses,
  bugprone-macro-repeated-side-effects,
  bugprone-misplaced-operator-in-strlen-in-alloc,
  bugprone-posix-return,
  bugprone-redundant-branch-condition,
  bugprone-sizeof-expression,
  bugprone-suspicious-memory-comparison,
  bugprone-suspicious-memset-usage,
  bugprone-suspicious-realloc-usage,
  bugprone-suspicious-semicolon,
  bugprone-suspicious-string-compare,
  bugprone-unused-return-value,
  readability-duplicate-include,
  readability-function-cognitive-complexity,
  readability-function-size,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-declaration,
  misc-misplaced-const
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(src|tests)/'
CheckOptions:
  readability-function-cognitive-complexity.Threshold: '25'
  readability-function-size.LineThreshold: '100'
  readability-function-size.StatementThreshold: '80'
  readability-function-size.ParameterThreshold: '6'
  readability-function-size.NestingThreshold: '5'
